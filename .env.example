# Copy to .env (git-ignored) and fill in ONE provider. Never commit real keys.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Model used for discovery (defaults: gpt-5.6-luna for OpenAI, claude-sonnet-5 for Anthropic)
# HANDS_MODEL=gpt-5.6-luna
# Note: gpt-5.6-luna on Chat Completions accepts function tools only with reasoning effort 'none',
# which is the default here. Per-call output cap (tokens): HANDS_MAX_OUTPUT_TOKENS=3000
